<%= form_with(model: @sale, local: true, class: "contents") do |form| %>

   <% if @sale.errors.any? %>
  <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
    <h2><%= pluralize(@sale.errors.count, "error") %> prohibited this sale from being saved:</h2>

    <ul class="list-disc pl-5 mt-2">
      <% @sale.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

    <div class="w-full">
    <%= form.label :user_id , class: "text-sm font-medium text-gray-700" %>
    <%= form.collection_select :user_id, User.all, :id, :alias, { prompt: "Select User" }, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
  </div>

  <div class="w-full">
  <%= form.label :client , class: "text-sm font-medium text-gray-700" %>
    <%= form.text_field :client, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
  </div>

  <div class="w-full">
  <%= form.label :realization_datetime , class: "text-sm font-medium text-gray-700" %>
    <%= form.datetime_field :realization_datetime, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
  </div>

  <h3 class="font-bold mb-2">Add Products</h3>
  <div id="products-section" data-index="<%= @sale.product_solds.length %>">
    <%= form.fields_for :product_solds do |product_form| %>
      <div class="product-item border-b pb-4 mb-4">
      <div class="w-full">
      <%= product_form.label :product_id, "Product", class: "text-sm font-medium text-gray-700" %>
  <%= product_form.collection_select :product_id, Product.where(deleted_at: nil), :id, :name, { prompt: "Select Product" }, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

  <div class="w-full">
  <%= product_form.label :amount, "Quantity" , class: "text-sm font-medium text-gray-700" %>
          <%= product_form.number_field :amount, min: 1, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div class="w-full">
        <%= product_form.check_box :_destroy %> 
          <%= product_form.label :_destroy, "Remove Product" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="w-full">
  <button type="button" id="add-product-btn" class="rounded-lg py-2 px-4 bg-green-600 text-white font-medium">
      Add Another Product
    </button>
  </div>

  <div class="inline mt-5">
      <%= form.submit class: "w-full bg-lilac text-darkPurple mt-2 p-2 border border-lilac rounded-xl hover:text-white hover:bg-darkLilac hover:cursor-pointer font-medium" %>
  </div>
<% end %>

<script>
  document.addEventListener('turbo:load', () => {
    initializeProductForm();
  });

  document.addEventListener('turbo:render', () => {
    initializeProductForm();
  });

  function initializeProductForm() {
    const addProductBtn = document.getElementById('add-product-btn');
    const productsSection = document.getElementById('products-section');
    let productIndex = parseInt(productsSection.getAttribute('data-index')) || 0;

    if (!addProductBtn) return;

    addProductBtn.addEventListener('click', () => {
      const existingForms = productsSection.querySelectorAll('.product-item');
      if (existingForms.length > productIndex) return; // Si ya existe el formulario, no agregamos otro

      const newProductForm = document.createElement('div');
      newProductForm.classList.add('product-item', 'border-b', 'pb-4', 'mb-4');

      newProductForm.innerHTML = `
  <div class="w-full">
          <label for="sale_product_solds_${productIndex}_product_id" class="text-sm font-medium text-gray-700">Product</label>
          <select name="sale[product_solds_attributes][${productIndex}][product_id]" id="sale_product_solds_${productIndex}_product_id" class="w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <option value="">Select Product</option>
            <% Product.all.each do |product| %>
              <option value="<%= product.id %>"><%= product.name %></option>
            <% end %>
          </select>
        </div>

  <div class="w-full">
          <label for="sale_product_solds_${productIndex}_amount" class="text-sm font-medium text-gray-700">Quantity</label>
          <input type="number" name="sale[product_solds_attributes][${productIndex}][amount]" id="sale_product_solds_${productIndex}_amount" min="1" class="w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        </div>

        <div class="my-3">
          <input type="checkbox" name="sale[product_solds_attributes][${productIndex}][_destroy]" id="sale_product_solds_${productIndex}__destroy">
          <label for="sale_product_solds_${productIndex}__destroy">Remove Product</label>
        </div>
      `;

      productsSection.appendChild(newProductForm);
      
      productIndex++;
      productsSection.setAttribute('data-index', productIndex);  
    });
  }
</script>
