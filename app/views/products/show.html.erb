<div class="mx-auto md:w-2/3 w-full flex p-10">
  <div class="mx-auto">
  <% if flash[:notice] %>
  <div class="w-full max-w-md mx-auto bg-green-500 text-white text-center py-2 px-4 rounded-xl mb-4">
    <%= flash[:notice] %>
  </div>
  <% flash.discard(:notice) %>
  <% end %>
  <% if flash[:alert] %>
  <div class="w-full bg-red-500 max-w-md mx-auto text-white text-center py-2 px-4 rounded-xl mb-4">
  <%= flash[:alert] %>
  </div>
  <% end %>

    <%= render @product %>
    
    <%= link_to "Back", request.referrer || root_path, class: "justify-center items-center text-center mt-2 p-2 rounded-xl bg-gray-100 font-medium border border-black hover:bg-black hover:text-white" %>

  </div>
</div>
