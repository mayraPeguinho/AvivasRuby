<div class="mx-auto md:w-2/3 w-full flex p-10">
  <div class="mx-auto">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
    <% end %>

    <%= render @product %>
    
    <%= link_to "Back", request.referrer || root_path, class: "justify-center items-center text-center mt-2 p-2 rounded-xl bg-gray-100 font-medium border border-black hover:bg-black hover:text-white" %>

  </div>
</div>
