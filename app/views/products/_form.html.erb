<%= form_with(model: product, class: "contents") do |form| %>
  <% if product.errors.any? %>
  <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
    <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

    <ul class="list-disc pl-5 mt-2">
      <% product.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

    <div class="w-full">
    <%= form.label :name , class: "text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
  </div>

  <div class="w-full">
  <%= form.label :description , class: "text-sm font-medium text-gray-700" %>
    <%= form.text_field :description, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
  </div>

  <div class="w-full">
  <%= form.label :inventory_entry_date , class: "text-sm font-medium text-gray-700" %>
    <%= form.date_field :inventory_entry_date, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
  </div>

  <div class="w-full">
  <%= form.label :available_stock, class: "text-sm font-medium text-gray-700" %>
    <%= form.number_field :available_stock, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
  </div>

  <div class="w-full">
  <%= form.label :unit_price , class: "text-sm font-medium text-gray-700" %>
  <%= form.number_field :unit_price, 
        class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
        required:true, 
        step: "0.01" %> <!-- step: "0.01" permite valores decimales -->
</div>
  
<div class="w-full">
<%= form.label :size_id , class: "text-sm font-medium text-gray-700" %>
      <%= form.collection_select :size_id, Size.all, :id, :name, { prompt: "Select Size" }, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
    </div>

    <div class="w-full">
    <%= form.label :color_id , class: "text-sm font-medium text-gray-700" %>
    <%= form.collection_select :color_id, Color.all, :id, :name, { prompt: "Select Color" }, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
  </div>

  <div class="w-full">
  <%= form.label :category_id , class: "text-sm font-medium text-gray-700" %>
    <%= form.collection_select :category_id, Category.all, :id, :name, { prompt: "Select Category" }, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
  </div>

  <% if product.persisted? && product.images.attached? %>
  <div class="w-full">
  <strong>Current Images:</strong>
  <ul class="flex">
    <% product.images.each do |image| %>
      <li class="flex items-center gap-4">
        <%= image_tag image, class: "w-32 h-32 object-cover" %>
    <% end %>
  </ul>
</div>
<% end %>

  <div class="w-full flex flex-col">
    <%= form.label :new_images, "Upload Images", class: "text-sm font-medium text-gray-700" %>
    <%= form.file_field :new_images, multiple: true, name: "product[new_images][]", class: "form-control" %>
  </div>

  <div class="inline">
      <%= form.submit class: "w-full bg-lilac text-darkPurple mt-2 p-2 border border-lilac rounded-xl hover:text-white hover:bg-darkLilac hover:cursor-pointer font-medium" %>
  </div>
<% end %>
